# Copy to server/.env and fill these values. Never commit the real token.
GLYPH_MODELS_DIR=/absolute/path/to/your/model-collection
GLYPH_BOARD_IP=192.168.4.2
GLYPH_ORIGIN=http://localhost:8765
GLYPH_BIND_ADDRESS=127.0.0.1
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
GLYPH_LOCAL_TOKEN=
